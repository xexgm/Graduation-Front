# 开发环境（真实后端，经由Vite代理避免CORS）
VITE_API_BASE_URL=/api
# 如果 Spring Boot 开启 HTTPS，可改为 https://localhost:8080
VITE_API_PROXY_TARGET=https://localhost:8080
# ws模式
# VITE_WS_URL=ws://localhost:9999/ws
# wss模式
VITE_WS_URL=wss://localhost:9999/ws
VITE_ENABLE_MOCK_AUTH=false
VITE_ENABLE_MOCK_WS=false
VITE_ENABLE_MOCK_DATA=false
